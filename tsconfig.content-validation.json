{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "./node_modules/.tmp/content-validation",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": [
    "scripts/validate-content.ts",
    "src/data/content/**/*.ts"
  ]
}
